<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="16dp">

    <!-- RZ - Botão de fechar no canto superior direito -->
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnCloseApp"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_close"
        android:contentDescription="Sair do App"
        app:tint="#000000" />

    <LinearLayout
        android:id="@+id/loginContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <!-- RZ - Texto informativo no topo da tela de login -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="PARA USAR ESTE APP VOCÊ PRECISA SE LOGAR"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="32dp"
            android:gravity="center"
            android:text="SOMENTE CELULARES CADASTRADOS PODEM\nTER ACESSO AO APP"
            android:textColor="#000000"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etPhoneNumber"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center_horizontal"
            android:hint="Ex. Telefone +5511912345678"
            android:inputType="phone"
            android:textColor="#000000"
            android:textColorHint="#757575" />

        <Button
            android:id="@+id/btnSendCode"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:backgroundTint="#000000"
            android:text="Enviar Código"
            android:textColor="#FFFFFF" />

        <EditText
            android:id="@+id/etVerificationCode"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:gravity="center_horizontal"
            android:hint="Ex. Código 123456"
            android:inputType="number"
            android:textColor="#000000"
            android:textColorHint="#757575"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:backgroundTint="#000000"
            android:text="Fazer Login"
            android:textColor="#FFFFFF"
            android:visibility="gone" />

        <!-- RZ - Barra de progresso para feedback visual de conexão -->
        <ProgressBar
            android:id="@+id/loginProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

    </LinearLayout>

</RelativeLayout>
